'use client'

import { useState, useEffect } from 'react'
import { motion } from 'framer-motion'
import Link from 'next/link'
import { createClient } from '@/lib/supabase/client'

type Demande = {
  id: string
  professeur_id: string
  enfant_id: string | null
  matiere: string | null
  message: string
  statut: string
  motif_refus: string | null
  nombre_enfants: number
  prix_souhaite: number | null
  niveaux_souhaites: string[]
  creneaux_souhaites: string[]
  paiement_effectue: boolean
  created_at: string
  prof?: {
    nom_complet: string
    photo_url: string | null
    quartier: string | null
  }
}

const labelsStatut: { [k: string]: { label: string; couleur: string; emoji: string } } = {
  en_attente: {
    label: 'En attente',
    couleur: 'bg-amber-100 text-amber-800 border-amber-200',
    emoji: '⏳',
  },
  acceptee: {
    label: 'Acceptée',
    couleur: 'bg-emerald-100 text-emerald-800 border-emerald-200',
    emoji: '✅',
  },
  refusee: {
    label: 'Refusée',
    couleur: 'bg-red-100 text-red-800 border-red-200',
    emoji: '❌',
  },
  terminee: {
    label: 'Terminée',
    couleur: 'bg-slate-100 text-slate-800 border-slate-200',
    emoji: '🎯',
  },
  annulee: {
    label: 'Annulée',
    couleur: 'bg-slate-100 text-slate-600 border-slate-200',
    emoji: '🚫',
  },
}

export default function MesDemandes() {
  const supabase = createClient()
  const [demandes, setDemandes] = useState<Demande[]>([])
  const [loading, setLoading] = useState(true)
  const [filtre, setFiltre] = useState<'toutes' | 'en_attente' | 'acceptee' | 'refusee'>('toutes')

  useEffect(() => {
    charger()
  }, [])

  const charger = async () => {
    setLoading(true)
    const { data: { user } } = await supabase.auth.getUser()
    if (!user) return

    const { data, error } = await supabase
      .from('demandes')
      .select('*')
      .eq('parent_id', user.id)
      .order('created_at', { ascending: false })

    if (error) {
      console.error('Erreur:', error)
      setLoading(false)
      return
    }

    // Récupérer les infos prof pour chaque demande
    const demandesCompletes: Demande[] = []

    for (const d of data || []) {
      const { data: prof } = await supabase
        .from('profiles')
        .select('nom_complet, photo_url')
        .eq('id', d.professeur_id)
        .single()

      demandesCompletes.push({
        ...d,
        prof: prof
          ? {
              nom_complet: prof.nom_complet,
              photo_url: prof.photo_url,
              quartier: null,
            }
          : undefined,
      })
    }

    setDemandes(demandesCompletes)
    setLoading(false)
  }

  const demandesFiltrees = demandes.filter((d) => {
    if (filtre === 'toutes') return true
    return d.statut === filtre
  })

  const compteParStatut = (statut: string) => {
    return demandes.filter((d) => d.statut === statut).length
  }

  if (loading) {
    return (
      <div className="flex items-center justify-center py-20">
        <motion.div
          animate={{ rotate: 360 }}
          transition={{ duration: 1, repeat: Infinity, ease: 'linear' }}
          className="w-12 h-12 border-4 border-blue-700 border-t-transparent rounded-full"
        />
      </div>
    )
  }

  return (
    <div className="space-y-6">
      <Link
        href="/espace-parent"
        className="text-sm text-slate-500 hover:text-blue-600 inline-flex items-center gap-1"
      >
        ← Retour au tableau de bord
      </Link>

      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        className="bg-white/80 backdrop-blur-xl rounded-3xl p-6 md:p-8 border border-white/80 shadow-xl"
      >
        <div className="flex items-start justify-between flex-wrap gap-4 mb-6">
          <div>
            <h1 className="text-3xl font-black text-slate-900 mb-1">
              📤 Mes demandes
            </h1>
            <p className="text-slate-600 text-sm">
              {demandes.length} demande{demandes.length > 1 ? 's' : ''} au total
            </p>
          </div>
          <Link
            href="/espace-parent/recherche"
            className="px-5 py-3 rounded-xl font-bold text-white bg-gradient-to-r from-blue-700 to-indigo-600 shadow-lg hover:shadow-xl hover:scale-[1.02] transition-all text-sm"
          >
            🔍 Nouvelle recherche
          </Link>
        </div>

        {/* Filtres */}
        <div className="flex flex-wrap gap-2 mb-6">
          {[
            { val: 'toutes', label: 'Toutes', count: demandes.length },
            { val: 'en_attente', label: '⏳ En attente', count: compteParStatut('en_attente') },
            { val: 'acceptee', label: '✅ Acceptées', count: compteParStatut('acceptee') },
            { val: 'refusee', label: '❌ Refusées', count: compteParStatut('refusee') },
          ].map((f) => (
            <button
              key={f.val}
              onClick={() => setFiltre(f.val as any)}
              className={`px-4 py-2 rounded-xl font-bold text-sm transition-all ${
                filtre === f.val
                  ? 'bg-gradient-to-r from-blue-700 to-indigo-600 text-white shadow-lg'
                  : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
              }`}
            >
              {f.label} ({f.count})
            </button>
          ))}
        </div>

        {/* Liste */}
        {demandesFiltrees.length === 0 ? (
          <div className="text-center py-16">
            <div className="text-6xl mb-4">📭</div>
            <h3 className="font-black text-slate-900 text-xl mb-2">
              Aucune demande
            </h3>
            <p className="text-slate-600 text-sm mb-6">
              {filtre === 'toutes'
                ? "Vous n'avez pas encore envoyé de demandes."
                : 'Aucune demande dans cette catégorie.'}
            </p>
            <Link
              href="/espace-parent/recherche"
              className="inline-block px-6 py-3 rounded-xl font-bold text-white bg-gradient-to-r from-blue-700 to-indigo-600 shadow-lg"
            >
              🔍 Trouver un prof
            </Link>
          </div>
        ) : (
          <div className="space-y-4">
            {demandesFiltrees.map((d, i) => {
              const statutInfo = labelsStatut[d.statut] || labelsStatut.en_attente
              return (
                <motion.div
                  key={d.id}
                  initial={{ opacity: 0, y: 10 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ duration: 0.3, delay: i * 0.05 }}
                  className="bg-white rounded-2xl p-5 border-2 border-slate-200 hover:border-blue-300 transition-all"
                >
                  <div className="flex items-start gap-4 flex-wrap">
                    {d.prof?.photo_url ? (
                      <img
                        src={d.prof.photo_url}
                        alt={d.prof.nom_complet}
                        className="w-16 h-16 rounded-2xl object-cover shadow-md flex-shrink-0"
                      />
                    ) : (
                      <div className="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-700 to-indigo-600 flex items-center justify-center text-white text-3xl shadow-md flex-shrink-0">
                        👨‍🏫
                      </div>
                    )}

                    <div className="flex-1 min-w-[200px]">
                      <div className="flex justify-between items-start flex-wrap gap-2 mb-2">
                        <div>
                          <div className="font-black text-slate-900 text-lg">
                            {d.prof?.nom_complet || 'Prof inconnu'}
                          </div>
                          <div className="text-xs text-slate-500">
                            {new Date(d.created_at).toLocaleDateString('fr-FR', {
                              day: 'numeric',
                              month: 'long',
                              year: 'numeric',
                            })}
                          </div>
                        </div>
                        <span
                          className={`text-xs px-3 py-1.5 rounded-full font-bold border ${statutInfo.couleur}`}
                        >
                          {statutInfo.emoji} {statutInfo.label}
                        </span>
                      </div>

                      {/* Détails de la demande */}
                      <div className="grid grid-cols-2 gap-2 mb-3 text-xs">
                        <div className="bg-slate-50 rounded-lg p-2">
                          <div className="text-slate-500 font-bold">
                            👶 Enfants
                          </div>
                          <div className="text-slate-900 font-black">
                            {d.nombre_enfants || 1}
                          </div>
                        </div>
                        <div className="bg-slate-50 rounded-lg p-2">
                          <div className="text-slate-500 font-bold">
                            💰 Prix
                          </div>
                          <div className="text-slate-900 font-black">
                            {d.prix_souhaite
                              ? `${Number(d.prix_souhaite).toLocaleString()} DJF`
                              : '—'}
                          </div>
                        </div>
                      </div>

                      {d.niveaux_souhaites && d.niveaux_souhaites.length > 0 && (
                        <div className="mb-2">
                          <div className="text-[10px] text-slate-500 font-bold mb-1">
                            🎓 NIVEAUX
                          </div>
                          <div className="flex flex-wrap gap-1">
                            {d.niveaux_souhaites.map((n) => (
                              <span
                                key={n}
                                className="text-[10px] bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full font-bold capitalize"
                              >
                                {n}
                              </span>
                            ))}
                          </div>
                        </div>
                      )}

                      {d.matiere && (
                        <div className="mb-3">
                          <div className="text-[10px] text-slate-500 font-bold mb-1">
                            📚 MATIÈRES
                          </div>
                          <div className="text-xs text-slate-700">
                            {d.matiere}
                          </div>
                        </div>
                      )}

                      {d.motif_refus && (
                        <div className="bg-red-50 border-l-4 border-red-500 p-3 rounded-lg mb-3">
                          <div className="text-[10px] text-red-700 font-bold">
                            MOTIF DU REFUS
                          </div>
                          <div className="text-xs text-red-800">
                            {d.motif_refus}
                          </div>
                        </div>
                      )}

                      {/* Actions selon statut */}
                      {d.statut === 'en_attente' && (
                        <div className="bg-amber-50 border-l-4 border-amber-500 p-3 rounded-lg">
                          <p className="text-xs text-amber-800">
                            ⏳ Nous avons bien reçu votre demande. L'équipe va
                            vous contacter sur WhatsApp pour organiser la suite.
                          </p>
                        </div>
                      )}

                      {d.statut === 'acceptee' && (
                        <div className="flex flex-wrap gap-2">
                          <a
                            href="https://wa.me/25377741482"
                            target="_blank"
                            rel="noopener noreferrer"
                            className="px-4 py-2 bg-green-500 text-white rounded-xl font-bold text-xs hover:bg-green-600 transition-colors"
                          >
                            💬 WhatsApp
                          </a>
                          <Link
                            href="/espace-parent/mes-profs"
                            className="px-4 py-2 bg-blue-50 text-blue-700 rounded-xl font-bold text-xs hover:bg-blue-100 transition-colors"
                          >
                            👨‍🏫 Voir mes profs
                          </Link>
                        </div>
                      )}

                      {d.statut === 'refusee' && (
                        <Link
                          href="/espace-parent/recherche"
                          className="inline-block px-4 py-2 bg-blue-50 text-blue-700 rounded-xl font-bold text-xs hover:bg-blue-100 transition-colors"
                        >
                          🔍 Chercher un autre prof
                        </Link>
                      )}
                    </div>
                  </div>
                </motion.div>
              )
            })}
          </div>
        )}
      </motion.div>
    </div>
  )
}