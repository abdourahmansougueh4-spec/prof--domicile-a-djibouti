'use client'

import { useState, useEffect } from 'react'
import { motion } from 'framer-motion'
import Link from 'next/link'
import { createClient } from '@/lib/supabase/client'

const jours = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche']

const creneaux = [
  { val: 'matin', label: 'Matin', horaire: '8h-12h', emoji: '🌅' },
  { val: 'apres_midi', label: 'Après-midi', horaire: '12h-17h', emoji: '☀️' },
  { val: 'soir', label: 'Soir', horaire: '17h-21h', emoji: '🌙' },
]

export default function DisponibilitesProfesseur() {
  const supabase = createClient()

  const [dispos, setDispos] = useState<{ [jour: string]: string[] }>({})
  const [loading, setLoading] = useState(true)
  const [sauvegarde, setSauvegarde] = useState(false)
  const [succes, setSucces] = useState(false)
  const [erreur, setErreur] = useState('')
  const [modifications, setModifications] = useState(false)

  useEffect(() => {
    charger()
  }, [])

  const charger = async () => {
    const { data: { user } } = await supabase.auth.getUser()
    if (!user) return

    const { data } = await supabase
      .from('disponibilites')
      .select('jour, creneau')
      .eq('professeur_id', user.id)

    const nouvellesDispos: { [jour: string]: string[] } = {}
    jours.forEach((j) => {
      nouvellesDispos[j] = []
    })

    ;(data || []).forEach((d) => {
      if (nouvellesDispos[d.jour]) {
        nouvellesDispos[d.jour].push(d.creneau)
      }
    })

    setDispos(nouvellesDispos)
    setLoading(false)
  }

  const toggle = (jour: string, creneau: string) => {
    const actuel = dispos[jour] || []
    const nouveaux = actuel.includes(creneau)
      ? actuel.filter((c) => c !== creneau)
      : [...actuel, creneau]
    setDispos({ ...dispos, [jour]: nouveaux })
    setModifications(true)
  }

  const total = Object.values(dispos).flat().length

  const enregistrer = async () => {
    if (total < 4) {
      setErreur('Minimum 4 séances par semaine obligatoire')
      return
    }

    setSauvegarde(true)
    setErreur('')

    try {
      const { data: { user } } = await supabase.auth.getUser()
      if (!user) return

      // Supprimer les anciennes dispos
      await supabase
        .from('disponibilites')
        .delete()
        .eq('professeur_id', user.id)

      // Insérer les nouvelles
      const disposData: { professeur_id: string; jour: string; creneau: string }[] = []
      Object.entries(dispos).forEach(([jour, creneauxJour]) => {
        creneauxJour.forEach((creneau) => {
          disposData.push({
            professeur_id: user.id,
            jour,
            creneau,
          })
        })
      })

      const { error } = await supabase.from('disponibilites').insert(disposData)
      if (error) throw error

      setSucces(true)
      setModifications(false)
      setTimeout(() => setSucces(false), 3000)
    } catch (err: any) {
      setErreur(err.message || 'Erreur')
    } finally {
      setSauvegarde(false)
    }
  }

  if (loading) {
    return (
      <div className="flex items-center justify-center py-20">
        <motion.div
          animate={{ rotate: 360 }}
          transition={{ duration: 1, repeat: Infinity, ease: 'linear' }}
          className="w-12 h-12 border-4 border-emerald-700 border-t-transparent rounded-full"
        />
      </div>
    )
  }

  return (
    <div className="space-y-6">
      <Link
        href="/espace-professeur"
        className="text-sm text-slate-500 hover:text-emerald-600 inline-flex items-center gap-1"
      >
        ← Retour au tableau de bord
      </Link>

      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        className="bg-white/80 backdrop-blur-xl rounded-3xl p-6 md:p-8 border border-white/80 shadow-xl"
      >
        <div className="flex items-start justify-between flex-wrap gap-4 mb-6">
          <div>
            <h1 className="text-3xl font-black text-slate-900 mb-1">
              📅 Mes disponibilités
            </h1>
            <p className="text-slate-600 text-sm">
              Modifiez vos horaires à tout moment
            </p>
          </div>
          <button
            onClick={enregistrer}
            disabled={sauvegarde || !modifications}
            className="px-5 py-3 rounded-xl font-bold text-white bg-gradient-to-r from-emerald-600 to-blue-700 shadow-lg hover:shadow-xl transition-all disabled:opacity-50"
          >
            {sauvegarde
              ? '⏳ Sauvegarde...'
              : modifications
              ? '💾 Enregistrer'
              : '✓ À jour'}
          </button>
        </div>

        {succes && (
          <motion.div
            initial={{ opacity: 0, y: -10 }}
            animate={{ opacity: 1, y: 0 }}
            className="mb-4 bg-emerald-50 border border-emerald-200 rounded-xl p-4 flex items-center gap-3"
          >
            <span className="text-xl">✅</span>
            <p className="text-emerald-700 text-sm font-bold">
              Disponibilités sauvegardées !
            </p>
          </motion.div>
        )}

        {erreur && (
          <motion.div
            initial={{ opacity: 0, y: -10 }}
            animate={{ opacity: 1, y: 0 }}
            className="mb-4 bg-red-50 border border-red-200 rounded-xl p-4 flex items-start gap-3"
          >
            <span className="text-xl">⚠️</span>
            <p className="text-red-700 text-sm font-medium">{erreur}</p>
          </motion.div>
        )}

        <motion.div
          animate={{
            backgroundColor: total >= 4 ? '#ecfdf5' : '#fef3c7',
            borderColor: total >= 4 ? '#10b981' : '#f59e0b',
          }}
          className="rounded-2xl p-5 border-2 mb-6"
        >
          <div className="flex items-center justify-between flex-wrap gap-3">
            <div>
              <div className="font-bold text-slate-900">
                {total >= 4 ? '✓' : '⏳'} {total} séance{total > 1 ? 's' : ''} par semaine
              </div>
              <div className="text-xs text-slate-600 mt-1">
                Minimum requis : <strong>4 séances</strong>
              </div>
            </div>
            {total >= 4 ? (
              <span className="text-xs bg-emerald-600 text-white px-3 py-1.5 rounded-full font-bold">
                ✓ Validé
              </span>
            ) : (
              <span className="text-xs bg-amber-500 text-white px-3 py-1.5 rounded-full font-bold">
                Encore {4 - total}
              </span>
            )}
          </div>
        </motion.div>

        <div className="space-y-3">
          {jours.map((jour) => (
            <div key={jour} className="bg-white rounded-2xl p-4 border-2 border-slate-200">
              <div className="flex items-center justify-between mb-3">
                <div className="font-bold text-slate-800">{jour}</div>
                {dispos[jour]?.length > 0 && (
                  <span className="text-[10px] bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full font-bold">
                    {dispos[jour].length} créneau{dispos[jour].length > 1 ? 'x' : ''}
                  </span>
                )}
              </div>
              <div className="grid grid-cols-3 gap-2">
                {creneaux.map((c) => {
                  const actif = dispos[jour]?.includes(c.val)
                  return (
                    <motion.button
                      key={c.val}
                      type="button"
                      whileHover={{ scale: 1.03 }}
                      whileTap={{ scale: 0.97 }}
                      onClick={() => toggle(jour, c.val)}
                      className={`p-3 rounded-xl font-bold text-xs transition-all flex flex-col items-center gap-1 relative ${
                        actif
                          ? 'bg-gradient-to-br from-emerald-600 to-emerald-500 text-white shadow-lg border-2 border-emerald-700'
                          : 'bg-white text-slate-700 border-2 border-slate-200 hover:border-emerald-300'
                      }`}
                    >
                      {actif && (
                        <div className="absolute -top-1.5 -right-1.5 w-5 h-5 bg-white rounded-full flex items-center justify-center shadow-md border-2 border-emerald-600">
                          <svg
                            className="w-2.5 h-2.5 text-emerald-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              strokeLinecap="round"
                              strokeLinejoin="round"
                              strokeWidth={4}
                              d="M5 13l4 4L19 7"
                            />
                          </svg>
                        </div>
                      )}
                      <span className="text-lg">{c.emoji}</span>
                      <span>{c.label}</span>
                      <span
                        className={`text-[10px] ${
                          actif ? 'text-emerald-100' : 'text-slate-400'
                        }`}
                      >
                        {c.horaire}
                      </span>
                    </motion.button>
                  )
                })}
              </div>
            </div>
          ))}
        </div>

        <div className="mt-6 bg-blue-50 border-l-4 border-blue-500 p-4 rounded-xl">
          <p className="text-xs text-blue-800">
            💡 <strong>Astuce :</strong> Plus vous avez de créneaux, plus vous
            recevrez de demandes. Essayez d'avoir au moins 6 créneaux par
            semaine.
          </p>
        </div>
      </motion.div>
    </div>
  )
}